# Database
DATABASE_URL="postgresql://gombe:gombe@localhost:5434/gombejobs?schema=public"

# Redis (BullMQ queue + rate limiting)
REDIS_URL="redis://localhost:6380"

# Google Cloud Storage (private bucket, uniform bucket-level access, public access prevention enforced)
GCS_BUCKET="gombe-resumes"
GCS_PROJECT_ID="your-gcp-project"
# Production: leave empty to use the runtime service account (ADC). Otherwise paste a service account key JSON on one line.
GCS_CREDENTIALS_JSON=""
# Local dev only: fake-gcs-server from docker-compose. Leave empty in production.
GCS_API_ENDPOINT="http://localhost:4443"

# SMTP (Resend: smtp.resend.com / port 465 / user "resend" / API key as password; Google Workspace SMTP relay also works)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Gombe State Civil Service Job Portal <no-reply@example.gov.ng>"

# ClamAV daemon (required in production; scans fail closed)
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# Used only by `npm run db:seed` to create the first admin (password: 12+ characters)
ADMIN_EMAIL="admin@example.gov.ng"
ADMIN_PASSWORD=""

# Public URL of the site (used for admin links in emails)
APP_URL="http://localhost:3000"

# Cloudflare Turnstile CAPTCHA (required in production). Dev test keys that always pass:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Data retention (worker purges daily)
RETENTION_SCREENED_OUT_DAYS="90"
RETENTION_APPLICATIONS_DAYS="365"

# Shown on the privacy notice
PRIVACY_CONTACT_EMAIL=""
